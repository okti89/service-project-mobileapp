{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal"
    },
    "uygar-apk": {
      "channel": "uygar-production",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "uygar"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "erkmen-apk": {
      "channel": "erkmen-production",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "erkmen"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
