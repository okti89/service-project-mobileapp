            "bundleIdentifier": "com.servis.asistani",
            "buildNumber": "1",
            "googleServicesFile": "./GoogleService-Info.plist",
            "config": {
                "googleMapsApiKey": "AIzaSyBt7Enn5_ipPhILE8XMAI5roAGZQVpCvgE"
            },
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false,
