                "NSLocationWhenInUseUsageDescription": "Teknisyenlerin konumunu güncel tutmak için konum izni gerekiyor.",
                "NSLocationAlwaysAndWhenInUseUsageDescription": "Arka planda konum takibi için izin gerekiyor. Bu sayede teknisyen konumu güncel tutulur.",
                "NSUserNotificationUsageDescription": "Servis ile ilgili durum ve güncellemeleri gönderebilmek için bildirim izni gerekiyor.",
                "UIBackgroundModes": [
                    "location"
                ]
            }
        },
        "android": {
            "package": "com.servis.asistani",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#F5F7FA"
            },
            "edgeToEdgeEnabled": true,
            "config": {
                "googleMaps": {
                    "apiKey": "AIzaSyBt7Enn5_ipPhILE8XMAI5roAGZQVpCvgE"
                }
            },
            "permissions": [
                "android.permission.ACCESS_COARSE_LOCATION",
                "android.permission.ACCESS_FINE_LOCATION",
                "android.permission.ACCESS_BACKGROUND_LOCATION",
                "android.permission.FOREGROUND_SERVICE",
                "android.permission.FOREGROUND_SERVICE_LOCATION",
                "android.permission.CAMERA"
            ],
            "googleServicesFile": "./google-services.json"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "@react-native-community/datetimepicker",
            "expo-font",
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Teknisyenlerin konumunu güncel tutmak için konum izni gerekiyor.",
                    "locationAlwaysAndWhenInUsePermission": "Arka planda konum takibi için izin gerekiyor. Bu sayede teknisyen konumu güncel tutulur.",
                    "isAndroidBackgroundLocationEnabled": true,
                    "isAndroidForegroundServiceEnabled": true
                }
            ],
            [
                "expo-camera",
                {
                    "cameraPermission": "Servis fişlerindeki barkodları okutabilmeniz için kamera izni gerekiyor.",
                    "recordAudioAndroid": false
                }
            ],
            [
                "expo-image-picker",
                {
                    "photosPermission": "Servis ile ilgili fotoğrafları ekleyebilmek için fotoğraf izni gerekiyor.",
                    "cameraPermission": "Servis ile ilgili fotoğrafları ekleyebilmek için kamera izni gerekiyor."
                }
            ],
            [
                "expo-notifications",
                {
                    "icon": "./assets/notification-icon.png",
                    "color": "#ffffff"
                }
            ],
            [
                "expo-splash-screen",
